    {
      "SkillType": "Inherent Skill",
      "SkillName": "Woven Scent",
      "SkillDescribe": "While casting <span style=\"color:#ffd12f;\" class=\"font-bold\">Heavy Attack - Woven Fairytale</span> or <span style=\"color:#ffd12f;\" class=\"font-bold\">Heavy Attack - Woven Phantasm</span>, Lily additionally restores 6 points of Concerto Energy per second for 3s. This effect can be triggered once every 20s.<br>Casting <span style=\"color:#ffd12f;\" class=\"font-bold\">Heavy Attack - Fairytale's Finale</span> or <span style=\"color:#ffd12f;\" class=\"font-bold\">Heavy Attack - Phantasm's End</span> additionally restores 10 points of Concerto Energy. This effect can be triggered once every 20s.",
      "SkillAttributes": []
    },
    {
      "SkillType": "Inherent Skill",
      "SkillName": "Flowers for You",
      "SkillDescribe": "While the active Resonator has 50% or more HP, Lily grants them 10% DMG Reduction.<br>When a Resonator in the team takes a fatal blow, they will not be downed and will instead gain a Shield equal to 10% of Lily's Max HP for 10s. This effect can be triggered once every 5 min.<br>Casting <span style=\"color:#ffd12f;\" class=\"font-bold\">Heavy Attack - Fairytale's Finale</span> or <span style=\"color:#ffd12f;\" class=\"font-bold\">Heavy Attack - Phantasm's End</span> grants <span style=\"color:#ffd12f;\" class=\"font-bold\">Floral Blessing</span> to Resonators in the team.<br><size=10></span><br><br><span class=\"font-bold font-whitney text-3xl style=\"color:aliceblue;\">Floral Blessing</span></span><br><br>Lasts for 60s. When a Resonator in the team takes DMG that brings their HP below 50% of their Max HP, they restore HP equal to 50% of their Max HP, and <span style=\"color:#ffd12f;\" class=\"font-bold\">Floral Blessing</span> is removed. This effect can be triggered once every 120s.",
      "SkillAttributes": []
    },
